<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/toolbar_game" android:id="@+id/navigation" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/screenContent" android:padding="@dimen/screen_padding" android:focusableInTouchMode="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:textColor="@color/accent" android:text="@string/ui_tag_strategy" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Title" android:layout_marginTop="10dp" android:text="@string/ui_arena_heading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:layout_marginTop="10dp" android:text="@string/ui_arena_instructions" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_scoreboard" android:padding="24dp" android:layout_marginTop="24dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:gravity="center" android:textColor="@color/on_accent_muted" android:text="@string/you" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Metric" android:id="@+id/playerScore" android:gravity="center" android:textColor="@color/white" android:textSize="44sp" android:layout_marginTop="8dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:gravity="center" android:textColor="@color/on_accent_muted" android:lineSpacingExtra="5dp" android:text="@string/ui_first_to_two" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:gravity="center" android:textColor="@color/on_accent_muted" android:text="@string/ui_device_short" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Metric" android:id="@+id/deviceScore" android:gravity="center" android:textColor="@color/white" android:textSize="44sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" android:text="@string/ui_your_move" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/rockButton" android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/rock" android:importantForAccessibility="yes" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/mode_background" app:strokeColor="@color/choice_stroke" app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="22dp" android:paddingBottom="22dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:importantForAccessibility="noHideDescendants">
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_rock" android:layout_gravity="center_horizontal" android:contentDescription="@null" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:gravity="center" android:layout_marginTop="14dp" android:textSize="14sp" android:text="@string/rock" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/paperButton" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/paper" android:importantForAccessibility="yes" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/mode_background" app:strokeColor="@color/choice_stroke" app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="22dp" android:paddingBottom="22dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:importantForAccessibility="noHideDescendants">
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_paper" android:layout_gravity="center_horizontal" android:contentDescription="@null" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:gravity="center" android:layout_marginTop="14dp" android:textSize="14sp" android:text="@string/paper" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/scissorsButton" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="0dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/scissors" android:importantForAccessibility="yes" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/mode_background" app:strokeColor="@color/choice_stroke" app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="22dp" android:paddingBottom="22dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:importantForAccessibility="noHideDescendants">
                        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_scissors" android:layout_gravity="center_horizontal" android:contentDescription="@null" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:gravity="center" android:layout_marginTop="14dp" android:textSize="14sp" android:text="@string/scissors" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/arenaBoard" android:background="@drawable/bg_card" android:padding="20dp" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arcade" android:id="@+id/playerChoiceIcon" android:layout_gravity="center_horizontal" android:contentDescription="@null" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:id="@+id/playerChoiceName" android:gravity="center" android:layout_marginTop="12dp" android:text="@string/ui_waiting_choice" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:gravity="center" android:layout_marginTop="4dp" android:text="@string/you" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:padding="8dp" android:text="@string/ui_versus" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:id="@+id/deviceChoicePanel">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arcade" android:id="@+id/deviceChoiceIcon" android:layout_gravity="center_horizontal" android:contentDescription="@null" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:id="@+id/deviceChoiceName" android:gravity="center" android:layout_marginTop="12dp" android:text="@string/ui_waiting_choice" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:gravity="center" android:layout_marginTop="4dp" android:text="@string/device" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Heading" android:id="@+id/roundMessage" android:textSize="18sp" android:gravity="center" android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite" android:text="@string/round_choose" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/newMatchButton" style="@style/Widget.PocketArcade.Button.Primary" android:layout_marginTop="20dp" android:visibility="gone" android:text="@string/new_match" app:icon="@drawable/ic_refresh" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
