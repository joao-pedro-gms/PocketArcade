<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" android:id="@+id/entryScrollView" android:fillViewport="true" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/entryContent" android:padding="@dimen/screen_padding" android:paddingTop="28dp" android:focusableInTouchMode="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_arcade" app:tint="@color/accent" android:contentDescription="@string/logo_description" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Heading" android:layout_marginStart="12dp" android:text="@string/presentation_title" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:layout_marginTop="48dp" android:textColor="@color/accent" android:text="@string/ui_intro_kicker" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Hero" android:layout_marginTop="12dp" android:text="@string/ui_intro_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Body" android:textColor="@color/muted" android:layout_marginTop="16dp" android:text="@string/ui_intro_body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:id="@+id/lastModule" android:background="@drawable/bg_surface" android:padding="14dp" android:layout_marginTop="24dp" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:labelFor="@id/nicknameInput" android:id="@+id/nicknameLabel" android:layout_marginTop="32dp" android:text="@string/nickname_label" />
            <androidx.appcompat.widget.AppCompatEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/nicknameInput" style="@style/Widget.PocketArcade.Input" android:hint="@string/nickname_hint" android:inputType="textCapWords" android:layout_marginTop="10dp" android:imeOptions="actionDone" android:maxLines="1" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/enterButton" style="@style/Widget.PocketArcade.Button.Primary" android:layout_marginTop="16dp" android:text="@string/ui_enter" app:icon="@drawable/ic_forward" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="40dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:layout_marginTop="20dp" android:text="@string/ui_academic_label" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:id="@+id/studentInfo" android:layout_marginTop="10dp" android:lineSpacingExtra="5dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
