<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/toolbar_game" android:id="@+id/navigation" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/screenContent" android:padding="@dimen/screen_padding" android:focusableInTouchMode="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:textColor="@color/accent" android:text="@string/ui_tag_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Title" android:layout_marginTop="10dp" android:text="@string/ui_scanner_heading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:layout_marginTop="10dp" android:text="@string/ui_scanner_instructions" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:labelFor="@id/messageInput" android:layout_marginTop="28dp" android:text="@string/ui_message_label" />
            <androidx.appcompat.widget.AppCompatEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/messageInput" style="@style/Widget.PocketArcade.Input" android:hint="@string/ui_message_hint" android:inputType="textCapSentences|textMultiLine" android:minHeight="144dp" android:singleLine="false" android:maxLines="8" android:gravity="top|start" android:layout_marginTop="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:id="@+id/validationMessage" android:textColor="@color/coral" android:visibility="gone" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/analyzeButton" style="@style/Widget.PocketArcade.Button.Primary" android:layout_weight="1" android:text="@string/analyze" app:icon="@drawable/ic_scanner" />
                <com.google.android.material.button.MaterialButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/clearButton" style="@style/Widget.PocketArcade.Button.Secondary" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/clear" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/resultPanel" android:layout_marginTop="32dp" android:visibility="gone" android:accessibilityLiveRegion="polite">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Heading" android:layout_marginBottom="16dp" android:text="@string/scanner_result_heading" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_characters" style="@style/Text.PocketArcade.Body" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_character_note" style="@style/Text.PocketArcade.Supporting" android:layout_marginTop="4dp" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/charactersResult" style="@style/Text.PocketArcade.Metric" android:textSize="28sp" android:gravity="end" android:minWidth="56dp" android:layout_marginStart="16dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_words" style="@style/Text.PocketArcade.Body" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/wordsResult" style="@style/Text.PocketArcade.Metric" android:textSize="28sp" android:gravity="end" android:minWidth="56dp" android:layout_marginStart="16dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_vowels" style="@style/Text.PocketArcade.Body" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/vowelsResult" style="@style/Text.PocketArcade.Metric" android:textSize="28sp" android:gravity="end" android:minWidth="56dp" android:layout_marginStart="16dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_card" android:layout_marginTop="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Caption" android:text="@string/ui_reversed" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Body" android:id="@+id/reversedResult" android:layout_marginTop="10dp" android:textIsSelectable="true" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_card" android:layout_marginTop="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:layout_weight="1" android:text="@string/ui_palindrome" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Label" android:id="@+id/palindromeResult" android:textColor="@color/accent" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.PocketArcade.Supporting" android:layout_marginTop="10dp" android:text="@string/ui_palindrome_note" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
